<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light bar glyphs belong to light themes. Both false means light icons on our dark bars;
         extending the style here keeps the base theme free of API 27 attributes. -->
    <style name="Theme.MyDailyRoutine">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.MyDailyRoutine.Dialog">
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
