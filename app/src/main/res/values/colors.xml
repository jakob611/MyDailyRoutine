<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirror of the Compose palette in
  app/src/main/java/com/example/mydailyroutine/core/designsystem/theme/DesignSystem.kt.

  Only the views that cannot read Compose need it: the home-screen widget (RemoteViews inflate XML
  layouts) and the window background behind the first frame. Everything else takes its colour from
  RoutineColors, so this file is deliberately small - a second palette that grows is a palette that
  drifts.

  It is not left to discipline: tools/check_contrast.py parses both files and fails the build when a
  value here stops matching DesignSystem.kt, when a stray hex colour appears in res/layout or
  res/drawable, and when any of these colours fails its WCAG pair. The values themselves come from
  tools/derive_palette.py, which computes them from published Apple and Material constants.
-->
<resources>
    <color name="routine_background">#FF111317</color>
    <color name="routine_surface_1">#FF1A1C20</color>
    <color name="routine_surface_2">#FF1E2024</color>
    <color name="routine_surface_3">#FF282A2E</color>
    <color name="routine_surface_4">#FF333539</color>
    <color name="routine_sheet_surface">#FF0B0E13</color>
    <color name="routine_text_primary">#FFF8FBFF</color>
    <color name="routine_text_secondary">#FFDFE2E8</color>
    <color name="routine_text_muted">#FFC4C6CC</color>
    <color name="routine_spine">#FF56575D</color>
    <color name="routine_border">#27FFFFFF</color>
    <color name="routine_border_strong">#30FFFFFF</color>
    <color name="routine_card_border">#1AFFFFFF</color>
    <color name="routine_cobalt">#FFB2C4FF</color>
    <color name="routine_amber">#FFEFBC87</color>
    <color name="routine_sage">#FF9BD39D</color>
    <color name="routine_crimson">#FFFFB2A4</color>
    <color name="routine_violet">#FFE1B6F3</color>
    <color name="routine_indigo">#FFCABDFF</color>
    <color name="routine_neutral">#FFC5C5CA</color>
    <color name="routine_warning">#FFE9C300</color>
</resources>
