+
+/**
+ * The custom colour of a subject, chosen by feel instead of by typing six hex digits.
+ *
+ * One wheel, one slider:
+ *
+ * * the **wheel** is hue around the circle and saturation from the centre to the rim — a single
+ *   drag reaches any of the millions of hues the shelf's sixteen swatches do not carry;
+ * * the **slider** below is brightness, because a wheel at full value cannot darken without
+ *   lying about what the reader just touched.
+ *
+ * The wheel itself is a bitmap rendered **once** (256 × 256 HSV pixels), not a Canvas that
+ * redraws hundreds of arcs on every frame: dragging the thumb then moves a node over a static
+ * image, which is the difference between a picker that tracks the finger and one that stutters.
+ * The preview swatch and the hex readout stay, because "it looks about right" is not the same as
+ * "it is #4F8CFF" — the readout is how a reader who needs the exact code finds it.
+ */
+@Composable
+fun SubjectColorPicker(
+    /** The colour the wheel and slider are showing (the editor's custom colour). */
+    customColor: Long,
+    /**
+     * Whether the editor's effective colour is this custom one or a shelf swatch. An inactive
+     * picker still works — touching it takes over — but it reads as not-the-current choice.
+     */
+    active: Boolean,
+    onColor: (Long) -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+) {
+    val haptics = LocalRoutineHaptics.current
+    val hsv = remember(customColor) { Color(customColor.toInt()).hsv }
+    val value = hsv[2]
+
+    Column(
+        modifier.fillMaxWidth()
+            .graphicsLayer { alpha = if (active && enabled) 1f else 0.38f },
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(RoutineSpacing.md),
+    ) {
+        // Preview: what the wheel is actually producing, with the exact code beside it.
+        Row(
+            Modifier.fillMaxWidth(),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(RoutineSpacing.sm),
+        ) {
+            Box(
+                Modifier.size(RoutineMetrics.SwatchSmall)
+                    .border(
+                        if (active) 3.dp else 1.dp,
+                        if (active) RoutineColors.TextPrimary else RoutineColors.Border,
+                        CircleShape,
+                    )
+                    .padding(3.dp)
+                    .background(Color(customColor.toInt()), CircleShape),
+            )
+            RoutineLabel(
+                text = hexOf(customColor),
+                style = MaterialTheme.typography.labelSmall,
+                color = RoutineColors.TextSecondary,
+            )
+            Spacer(Modifier.weight(1f))
+        }
+        ColorWheel(
+            color = customColor,
+            onColor = onColor,
+            value = value,
+            onHaptic = { haptics.selection() },
+            modifier = Modifier.size(WheelSize),
+            enabled = enabled,
+        )
+        Column(verticalArrangement = Arrangement.spacedBy(RoutineSpacing.xs)) {
+            RoutineLabel(
+                stringResource(R.string.subject_color_value),
+                style = MaterialTheme.typography.labelSmall,
+                color = RoutineColors.TextSecondary,
+            )
+            LiquidSlider(
+                value = value,
+                onValueChange = { v -> onColor(Color.hsv(hsv[0], hsv[1], v).toLong()) },
+                modifier = Modifier.fillMaxWidth(),
+                enabled = enabled,
+            )
+        }
+    }
+}
+
+/** The wheel's on-screen size; the bitmap behind it is fixed, the pane is not. */
+private val WheelSize = 180.dp
+
+/** The thumb the finger sees: solid, one hairline, never glass (glass over a moving list is noise). */
+private val ThumbSize = 20.dp
+
+/** The wheel is rendered at this resolution once, then drawn scaled. */
+private const val WheelResolution = 256
+
+/**
+ * Pre-renders the HSV wheel: hue by angle, saturation by radius, full value. Rendered once per
+ * composition host and kept — the alternative (redrawing the hue rings per frame) is exactly the
+ * kind of per-frame Canvas work that turns a colour picker into a stuttering one.
+ */
+private fun buildWheelBitmap(): android.graphics.ImageBitmap {
+    val size = WheelResolution
+    val center = (size - 1) / 2f
+    val pixels = IntArray(size * size)
+    for (y in 0 until size) {
+        for (x in 0 until size) {
+            val dx = x - center
+            val dy = y - center
+            val radius = sqrt(dx * dx + dy * dy) / center
+            val index = y * size + x
+            if (radius > 1f) continue
+            val hue = (Math.toDegrees(atan2(dy.toDouble(), dx.toDouble())).toFloat() + 360f) % 360f
+            val color = Color.hsv(hue, radius.coerceIn(0f, 1f), 1f).toArgb()
+            // Two pixels of anti-aliased rim: without it the circle reads as a hard cut.
+            val alpha = (255f * ((1f - radius) * 3f).coerceIn(0f, 1f)).toInt().coerceIn(0, 255)
+            pixels[index] = (color and 0x00FFFFFF) or (alpha shl 24)
+        }
+    }
+    return Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888).apply {
+        setPixels(pixels, 0, size, 0, 0)
+    }.asImageBitmap()
+}
+
+@Composable
+private fun ColorWheel(
+    color: Long,
+    onColor: (Long) -> Unit,
+    value: Float,
+    onHaptic: () -> Unit,
+    modifier: Modifier,
+    enabled: Boolean,
+) {
+    val bitmap = remember { buildWheelBitmap() }
+    val density = LocalDensity.current
+    var widthPx by remember { mutableFloatStateOf(0f) }
+    val hsv = remember(color) { Color(color.toInt()).hsv }
+    val thumbPx = with(density) { ThumbSize.toPx() }
+    val wheelDescription = stringResource(R.string.subject_color_wheel)
+
+    fun pick(x: Float, y: Float) {
+        if (widthPx <= 0f) return
+        val c = widthPx / 2f
+        val dx = x - c
+        val dy = y - c
+        val hue = (Math.toDegrees(atan2(dy.toDouble(), dx.toDouble())).toFloat() + 360f) % 360f
+        val saturation = (hypot(dx.toDouble(), dy.toDouble()).toFloat() / c).coerceIn(0f, 1f)
+        onColor(Color.hsv(hue, saturation, value).toLong())
+    }
+
+    Box(
+        modifier
+            .clip(CircleShape)
+            .onSizeChanged { widthPx = it.width.toFloat() }
+            .pointerInput(enabled, value) {
+                if (!enabled) return@pointerInput
+                detectTapGestures { position ->
+                    onHaptic()
+                    pick(position.x, position.y)
+                }
+            }
+            .pointerInput(enabled, value) {
+                if (!enabled) return@pointerInput
+                detectDragGestures(
+                    onDragStart = { position -> pick(position.x, position.y) },
+                    onDrag = { change, _ ->
+                        pick(change.position.x, change.position.y)
+                        change.consume()
+                    },
+                )
+            }
+            .semantics { contentDescription = wheelDescription },
+    ) {
+        Canvas(Modifier.fillMaxSize()) { drawImage(bitmap) }
+        // The thumb rides a draw-phase translation over the static bitmap: moving it never
+        // re-lays out the wheel, so the finger and the thumb move in the same frame.
+        val center = widthPx / 2f
+        val angle = Math.toRadians(hsv[0].toDouble())
+        val radius = hsv[1] * center
+        Box(
+            Modifier.size(ThumbSize)
+                .graphicsLayer {
+                    translationX = center + radius * cos(angle) - thumbPx / 2
+                    translationY = center + radius * sin(angle) - thumbPx / 2
+                }
+                .clip(CircleShape)
+                .background(RoutineColors.TextPrimary)
+                .border(2.dp, RoutineColors.Background, CircleShape),
+        )
+    }
+}
+
