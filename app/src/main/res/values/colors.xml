<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirror of the Compose palette in
  app/src/main/java/com/example/mydailyroutine/core/designsystem/theme/DesignSystem.kt.

  Only the views that cannot read Compose need it: the home-screen widget (RemoteViews inflate XML
  layouts) and the window background behind the first frame. Everything else takes its colour from
  RoutineColors, so this file is deliberately small — a second palette that grows is a palette that
  drifts.

  It is not left to discipline: tools/check_contrast.py parses both files and fails the build when a
  value here stops matching DesignSystem.kt, when a stray hex colour appears in res/layout or
  res/drawable, and when any of these colours fails its WCAG pair.
-->
<resources>
    <color name="routine_background">#FF0B0E13</color>
    <color name="routine_surface_1">#FF141922</color>
    <color name="routine_surface_2">#FF1B212C</color>
    <color name="routine_surface_3">#FF232A37</color>
    <color name="routine_surface_4">#FF2B3342</color>
    <color name="routine_sheet_surface">#FF101419</color>
    <color name="routine_text_primary">#FFF4F7FC</color>
    <color name="routine_text_secondary">#FFC6CEDC</color>
    <color name="routine_text_muted">#FFAAB3C3</color>
    <color name="routine_spine">#FF2C3542</color>
    <color name="routine_border">#1FFFFFFF</color>
    <color name="routine_border_strong">#33FFFFFF</color>
    <color name="routine_card_border">#1AFFFFFF</color>
    <color name="routine_cobalt">#FF85B1F9</color>
    <color name="routine_amber">#FFE5A746</color>
    <color name="routine_sage">#FF69CFA4</color>
    <color name="routine_crimson">#FFF9909F</color>
    <color name="routine_violet">#FFB9A1FA</color>
    <color name="routine_indigo">#FF929FF9</color>
    <color name="routine_warning">#FFF7A969</color>
</resources>
